# Default: original menu login + automatic account list, then server-side upstream tests.
DETECTION_MODE=auto
SUB2API_BASE_URL=https://your-sub2api.example.com
# Optional: browser-facing address when the server uses an internal API address.
# SUB2API_PUBLIC_URL=https://your-sub2api.example.com
INSTANCE_NAME=降智检测
# Optional additional Basic auth (both fields required if enabled).
# DC_AUTH_USER=operator
# DC_AUTH_PASSWORD=replace-with-at-least-16-random-characters
# Only for optional manual direct mode:
# UPSTREAMS_FILE=./upstreams.json
# RELAY_API_KEY=replace-with-upstream-key
